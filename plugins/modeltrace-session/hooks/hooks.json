{
  "hooks": {
    "SessionStart": [{
      "matcher": "^(startup|resume|clear|fork)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\" notice",
        "timeout": 5,
        "statusMessage": "ModelTrace: checking last result"
      }, {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
        "async": true,
        "timeout": 600,
        "statusMessage": "ModelTrace: testing in background"
      }]
    }]
  }
}
